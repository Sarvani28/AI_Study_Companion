import Link from "next/link";
import {
  ArrowLeft,
  BarChart3,
  Brain,
  FileText,
  MessageCircle,
  Target,
} from "lucide-react";
import { notFound } from "next/navigation";

import { AppShell } from "@/components/layout/app-shell";
import { createClient } from "@/lib/supabase/server";

type ProjectPageProps = {
  params: Promise<{
    projectId: string;
  }>;
};

export default async function ProjectPage({
  params,
}: ProjectPageProps) {
  const { projectId } = await params;

  const supabase = await createClient();

  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    notFound();
  }

  /*
   * Get the project.
   *
   * user_id check prevents opening somebody else's project.
   */
  const { data: project } = await supabase
    .from("projects")
    .select(
      `
        id,
        space_id,
        name,
        description,
        learning_goal
      `
    )
    .eq("id", projectId)
    .eq("user_id", user.id)
    .single();

  if (!project) {
    notFound();
  }

  /*
   * Get the parent space.
   */
  const { data: space } = await supabase
    .from("spaces")
    .select("id, name")
    .eq("id", project.space_id)
    .eq("user_id", user.id)
    .single();

  /*
   * Get project statistics.
   */
  const { count: materialCount } =
    await supabase
      .from("materials")
      .select("id", {
        count: "exact",
        head: true,
      })
      .eq("project_id", projectId)
      .eq("user_id", user.id);

  const { count: quizCount } =
    await supabase
      .from("quiz_sessions")
      .select("id", {
        count: "exact",
        head: true,
      })
      .eq("project_id", projectId)
      .eq("user_id", user.id)
      .eq("status", "completed");

  const { data: masteryRows } =
    await supabase
      .from("concept_mastery")
      .select("mastery_score")
      .eq("project_id", projectId)
      .eq("user_id", user.id);

  const mastery =
    masteryRows &&
    masteryRows.length > 0
      ? Math.round(
          masteryRows.reduce(
            (sum, row) =>
              sum +
              Number(
                row.mastery_score ?? 0
              ),
            0
          ) / masteryRows.length
        )
      : 0;

  const { data: quizRows } =
    await supabase
      .from("quiz_sessions")
      .select("score")
      .eq("project_id", projectId)
      .eq("user_id", user.id)
      .eq("status", "completed")
      .not("score", "is", null);

  const accuracy =
    quizRows && quizRows.length > 0
      ? Math.round(
          quizRows.reduce(
            (sum, row) =>
              sum +
              Number(row.score ?? 0),
            0
          ) / quizRows.length
        )
      : 0;

  return (
    <AppShell>
      <main className="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div className="space-y-8">
          {/* Back */}
          <Link
            href={`/spaces/${project.space_id}`}
            className="inline-flex items-center gap-2 text-sm text-gray-500 transition hover:text-gray-950"
          >
            <ArrowLeft className="h-4 w-4" />

            Back to {space?.name ?? "Space"}
          </Link>

          {/* Header */}
          <div>
            <p className="mb-2 text-sm font-medium text-gray-400">
              Project
            </p>

            <h1 className="text-3xl font-semibold tracking-tight text-gray-950">
              {project.name}
            </h1>

            {project.description && (
              <p className="mt-2 max-w-2xl text-sm leading-6 text-gray-500">
                {project.description}
              </p>
            )}
          </div>

          {/* Stats */}
          <div className="grid gap-4 sm:grid-cols-3">
            <StatCard
              label="Mastery"
              value={`${mastery}%`}
              icon={Brain}
            />

            <StatCard
              label="Materials"
              value={String(
                materialCount ?? 0
              )}
              icon={FileText}
            />

            <StatCard
              label="Quiz accuracy"
              value={`${accuracy}%`}
              icon={Target}
            />
          </div>

          {/* Learning goal */}
          {project.learning_goal && (
            <section className="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <p className="text-xs font-semibold uppercase tracking-[0.14em] text-gray-400">
                Learning goal
              </p>

              <p className="mt-3 max-w-3xl text-sm leading-7 text-gray-700">
                {project.learning_goal}
              </p>
            </section>
          )}

          {/* Project tools */}
          <section>
            <div className="mb-5">
              <h2 className="text-lg font-semibold text-gray-950">
                Continue learning
              </h2>

              <p className="mt-1 text-sm text-gray-500">
                Choose an area of your project.
              </p>
            </div>

            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <ProjectTool
                href={`/projects/${projectId}/materials`}
                title="Materials"
                description="Upload and manage your learning documents."
                icon={FileText}
              />

              <ProjectTool
                href={`/projects/${projectId}/tutor`}
                title="AI Tutor"
                description="Ask grounded questions about your materials."
                icon={MessageCircle}
              />

              <ProjectTool
                href={`/projects/${projectId}/quiz`}
                title="Quiz"
                description="Test your understanding with adaptive questions."
                icon={Target}
              />

              <ProjectTool
                href={`/projects/${projectId}/mastery`}
                title="Mastery"
                description="Track understanding across important concepts."
                icon={Brain}
              />

              <ProjectTool
                href={`/projects/${projectId}/growth`}
                title="Growth"
                description="See how your learning is progressing."
                icon={BarChart3}
              />

              <ProjectTool
                href={`/projects/${projectId}/analytics`}
                title="Analytics"
                description="Explore detailed learning activity."
                icon={BarChart3}
              />
            </div>
          </section>
        </div>
      </main>
    </AppShell>
  );
}

function StatCard({
  label,
  value,
  icon: Icon,
}: {
  label: string;
  value: string;
  icon: React.ComponentType<{
    className?: string;
  }>;
}) {
  return (
    <div className="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
      <div className="flex items-center gap-2 text-sm text-gray-500">
        <Icon className="h-4 w-4" />

        {label}
      </div>

      <p className="mt-3 text-2xl font-semibold text-gray-950">
        {value}
      </p>
    </div>
  );
}

function ProjectTool({
  href,
  title,
  description,
  icon: Icon,
}: {
  href: string;
  title: string;
  description: string;
  icon: React.ComponentType<{
    className?: string;
  }>;
}) {
  return (
    <Link
      href={href}
      className="group rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md"
    >
      <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-50 text-gray-700">
        <Icon className="h-5 w-5" />
      </div>

      <h3 className="mt-4 font-semibold text-gray-950">
        {title}
      </h3>

      <p className="mt-2 text-sm leading-6 text-gray-500">
        {description}
      </p>

      <p className="mt-4 text-sm font-medium text-gray-700 group-hover:text-gray-950">
        Open →
      </p>
    </Link>
  );
}